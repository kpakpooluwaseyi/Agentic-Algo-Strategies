[Unit]
Description=RBI Swarm API — FastAPI + Socket.IO Server
After=network.target redis.service
Requires=redis.service

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/moon-dev-ai-agents-for-trading
ExecStart=/home/%i/moon-dev-ai-agents-for-trading/venv/bin/uvicorn rbi_core.api.app:app --host 0.0.0.0 --port 8000 --workers 1
ExecStop=/bin/kill -SIGTERM $MAINPID
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rbi-api

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
